#server configuration
PORT=8000 #backend http server port
WebSocketPort=3000 #chat service websocket port

DEV_PORT=4000
DEV_WebSocketPort=443

STAGING_PORT=4500
STAGING_WebSocketPort=3500

#firebase authorization
FIREBASE_API_KEY="firebaseapikey" 
FIREBASE_AUTH_DOMAIN="firebaseauthdomain"
FIREBASE_PROJECT_ID="firebaseprojectid"
FIREBASE_STORAGE_BUCKET="firebasestoragebucket"
FIREBASE_MESSING_SENDER_ID="firebasemessagingsenderid"
FIREBASE_APP_ID="firebaseappid"
FIREBASE_MEASUREMENT_ID="firebasemeasurementid"

#non-prod authentication keys
STAGING_AUTH_KEY="stagingauthkey (uuid)"
DEVELOPER_AUTH_KEY="devauthkey (uuid)"